// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  password  String
  name      String
  avatar    String?
  isAI      Boolean  @default(false)
  lastSeen  DateTime?
  createdAt DateTime @default(now())

  sessionsAsUser1 ChatSession[] @relation("User1Sessions")
  sessionsAsUser2 ChatSession[] @relation("User2Sessions")
  messages        Message[]
  participants    SessionParticipant[]
}

model ChatSession {
  id        String   @id @default(uuid()) @db.Uuid
  user1Id   String?  @db.Uuid
  user2Id   String?  @db.Uuid
  isGroup   Boolean  @default(false)
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user1        User?                @relation("User1Sessions", fields: [user1Id], references: [id])
  user2        User?                @relation("User2Sessions", fields: [user2Id], references: [id])
  messages     Message[]
  participants SessionParticipant[]

  @@unique([user1Id, user2Id], map: "user_pair_unique")
  @@index([user1Id])
  @@index([user2Id])
  @@index([isGroup])
}

model Message {
  id          String   @id @default(uuid()) @db.Uuid
  sessionId   String   @db.Uuid
  senderId    String   @db.Uuid
  content     String
  type        String   @default("text")
  isRead      Boolean  @default(false)
  deliveredAt DateTime?
  readAt      DateTime?
  metadata    Json?
  createdAt   DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender  User        @relation(fields: [senderId], references: [id])

  @@index([sessionId])
  @@index([senderId])
  @@index([createdAt])
}

model SessionParticipant {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @db.Uuid
  userId    String   @db.Uuid
  joinedAt  DateTime @default(now())
  leftAt    DateTime?

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}
